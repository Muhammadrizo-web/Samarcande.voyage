# --- Côté site (build) ---
# Point d'entrée des formulaires (par défaut la fonction Cloudflare /api/lead)
NEXT_PUBLIC_LEAD_ENDPOINT=/api/lead
# 1 = formulaires en démonstration (aucun envoi réel) — uniquement pour les aperçus
NEXT_PUBLIC_DEMO_FORMS=0

# --- Côté fonction functions/api/lead.ts (variables Cloudflare Pages) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
LEAD_EMAIL_TO=contact@samarcande-voyage.com
LEAD_EMAIL_FROM=Site Samarcande Voyage <site@samarcande-voyage.com>
